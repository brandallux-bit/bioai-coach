{
  "permissions": {
    "allow": [
      "mcp__claude_ai_BioAI__*",
      "mcp__BioAI__*"
    ],
    "deny": [
      "Bash",
      "Write",
      "Edit",
      "NotebookEdit"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-key.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.bioai/update.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
